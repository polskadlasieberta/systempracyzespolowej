<Window x:Class="systemPracyZespołowej.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:systemPracyZespołowej"
        mc:Ignorable="d"
        Title="System pracy zespołowej" Height="600" Width="1000">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Role i użytkownicy" Grid.Column="0" Margin="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtNewRole" Width="140" Margin="0,0,4,0" Text=""/>
                        <Button Content="Dodaj rolę" Click="BtnAddRole_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBox x:Name="TxtNewUser" Width="140" Margin="0,0,4,0" Text=""/>
                        <Button Content="Dodaj do roli" Click="BtnAddUser_Click"/>
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="LbRoles" ItemsSource="{Binding Roles}" DisplayMemberPath="Name" Margin="4" SelectedIndex="0"/>
                <ListBox x:Name="LbUsers" DockPanel.Dock="Bottom" Height="140" Margin="4" />
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Etapy projektu" Grid.Column="1" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6">
                    <TextBox x:Name="TxtNewStage" Width="300" Margin="0,0,6,0" />
                    <Button Content="Dodaj etap" Click="BtnAddStage_Click"/>
                </StackPanel>

                <ListBox x:Name="LbStages" Grid.Row="1" Margin="6" ItemsSource="{Binding Stages}" DisplayMemberPath="Name" SelectedIndex="0"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Szczegóły etapu" Grid.Column="2" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="6" Orientation="Vertical">
                    <TextBlock Text="Opis:" FontWeight="Bold"/>
                    <TextBox x:Name="TxtStageDescription" AcceptsReturn="True" Height="80" TextWrapping="Wrap" TextChanged="TxtStageDescription_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtComment" Width="200" Margin="0,0,6,0" />
                    <TextBox x:Name="TxtCommentAuthor" Width="120" Margin="0,0,6,0" />
                    <Button Content="Dodaj komentarz" Click="BtnAddComment_Click"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Komentarze" Margin="4">
                        <ListBox x:Name="LbComments" DisplayMemberPath="Text"/>
                    </GroupBox>

                    <GroupBox Header="Historia zmian" Grid.Column="1" Margin="4">
                        <ListBox x:Name="LbHistory" DisplayMemberPath="Description"/>
                    </GroupBox>
                </Grid>
            </Grid>
        </GroupBox>

    </Grid>
</Window>

